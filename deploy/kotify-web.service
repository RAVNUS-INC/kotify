[Unit]
Description=kotify — Next.js 14 frontend (App Router)
Documentation=https://github.com/RAVNUS-INC/kotify
After=network-online.target kotify.service
Wants=network-online.target
# FastAPI가 먼저 기동되어 있는 편이 자연스럽지만 엄격 의존은 아님.
# After=kotify.service 로 순서만 주고, Requires 는 걸지 않는다.

[Service]
Type=simple
User=kotify
Group=kotify
WorkingDirectory=/opt/kotify/web
# Next.js standalone 산출물 위치. ct-bootstrap.sh 가 pnpm build 후
# .next/static 과 public/ 을 .next/standalone 안으로 복사해둔다.
ExecStart=/usr/bin/node /opt/kotify/web/.next/standalone/server.js

# 재시작 정책
Restart=on-failure
RestartSec=5

# 종료 — Next 는 SIGTERM 에 열린 요청이 끝날 때까지 기다리는데, 대화방 SSE 는 끝나지
# 않아 기본 90초 뒤 SIGKILL 로 끝났고 그동안 새 연결을 거절했다. 종료 유예 preload
# (kotify-web-shutdown.cjs, 5초 뒤 남은 연결을 끊고 exit 0)가 먼저 끝내고, 이 값은
# 그래도 안 끝날 때의 안전망이다. preload 는 저장소 밖 사본을 쓴다(git 롤백에 안 지워지게).
TimeoutStopSec=15
Environment=NODE_OPTIONS=--require=/usr/local/lib/kotify/kotify-web-shutdown.cjs
# preload 사본이 없으면 node 가 MODULE_NOT_FOUND 로 재시작을 반복한다 — 그 전에 원인이 보이게 멈춘다.
# 사본은 배포 때 kotify-post-restart.sh 가 갱신한다. 처음 한 번은 deploy/README 순서대로 직접 설치.
ExecStartPre=/usr/bin/test -r /usr/local/lib/kotify/kotify-web-shutdown.cjs

# 로그 — journalctl 로 확인 (별도 stdout 파일 없음, Next.js 콘솔 로그는 전부 journal 로)
StandardOutput=journal
StandardError=journal

# 환경변수
#   FASTAPI_URL: Next.js rewrites 대상. 운영은 loopback(127.0.0.1:8080)만.
#   HOSTNAME:    Next.js 서버 바인딩 주소. 0.0.0.0 으로 NPM 에서 프록시 받음.
#   PORT:        외부 대면 포트(NPM 이 여기로 프록시).
#   NODE_ENV:    production 모드 활성화 (Next.js 내부 최적화).
Environment=NODE_ENV=production
Environment=FASTAPI_URL=http://127.0.0.1:8080
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3000

# ── 보안 강화 (Systemd Hardening) ────────────────────────────────────────────
# kotify-web 은 정적 자원만 서빙하고 로그는 journal 로만 간다
# (StandardOutput/Error=journal). 디스크에 쓸 경로가 없으므로
# ReadWritePaths 를 전부 제거해 최소 권한 원칙을 강화한다.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
